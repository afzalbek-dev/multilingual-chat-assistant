# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/multilingual_chat
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_password
DATABASE_NAME=multilingual_chat

# AI & LLM Provider Configuration
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=uz,ru,en,es,fr,de,tr,zh
AI_MODEL_NAME=gemini-2.5-flash
AI_API_KEY=your_gemini_or_openai_api_key_here

# WebSocket Gateway
WS_HEARTBEAT_INTERVAL_MS=30000
WS_CLIENT_TIMEOUT_MS=60000
